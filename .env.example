# Copy to .env (git-ignored). Never commit real keys.

# OCR fallback: only used for scanned / image-only PDFs. Without it those PDFs are reported as failed.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6

# GitHub enrichment (optional token): raises the public API limit from 60 to 5000 requests/hour.
GITHUB_TOKEN=
